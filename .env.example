# Copy to .env and fill in locally. Never commit the real key.
#
# Meta Model API key for Muse Ember (Day 1 runs without it, on the stub).
META_MODEL_API_KEY=

# Optional overrides — defaults are in lib/ember.js
# EMBER_MODEL=muse-ember-preview
# EMBER_BASE_URL=https://api.meta.ai/v1
# EMBER_PRICE_IN_PER_MTOK=0.2
# EMBER_PRICE_OUT_PER_MTOK=0.2

# Local server port
# PORT=4173

# Hackathon budget shown in the cost meter
# HACKATHON_BUDGET_USD=10
