# Copy to .env and fill in locally. Never commit the real key.
#
# Meta Model API key for Muse Ember (Day 1 runs without it, on the stub).
META_MODEL_API_KEY=

# Optional overrides — defaults live in lib/ember.js.
# Confirmed against https://dev.meta.ai/models/muse-ember on 24 Nov 2026:
#   muse-ember-1.0, <200k context: $0.10 / Mtok input, $0.50 / Mtok output,
#                                 $0.004 / Mtok cached input
# EMBER_MODEL=muse-ember-1.0
# EMBER_BASE_URL=https://api.meta.ai/v1
# EMBER_PRICE_IN_PER_MTOK=0.1
# EMBER_PRICE_OUT_PER_MTOK=0.5
# EMBER_PRICE_CACHED_IN_PER_MTOK=0.004

# Local server port
# PORT=4173

# Hackathon budget shown in the cost meter
# HACKATHON_BUDGET_USD=10
